; systemd unit for ScholarDrop on AlmaLinux 9.
;
;   sudo useradd --system --home-dir /srv/scholardrop --shell /sbin/nologin scholardrop
;   sudo install -o scholardrop -g scholardrop -m 0750 -d /srv/scholardrop/uploads
;   sudo install -o root -g scholardrop -m 0640 .env /etc/scholardrop.env
;   sudo cp deploy/scholardrop.service /etc/systemd/system/
;   sudo systemctl daemon-reload && sudo systemctl enable --now scholardrop
;
; The app listens on loopback only; nginx (deploy/nginx-scholardrop.conf) is what
; faces the network and terminates TLS.

[Unit]
Description=ScholarDrop — drop a PDF, deposit a publication
Documentation=https://github.com/shareok/scholardrop
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=scholardrop
Group=scholardrop
WorkingDirectory=/srv/scholardrop/app

; Secrets live here, not in the unit: SCHOLARDROP_SECRET_KEY and
; SCHOLARDROP_ANTHROPIC_API_KEY at minimum. Mode 0640, owned root:scholardrop.
EnvironmentFile=/etc/scholardrop.env
Environment=PYTHONUNBUFFERED=1

; One worker: sessions and extraction jobs are in-process (DESIGN.md §2). Adding
; workers needs the Redis-backed SessionStore first, or users will be bounced
; between processes that do not know them.
ExecStart=/srv/scholardrop/app/.venv/bin/uvicorn \
    --factory scholardrop.app:create_app \
    --host 127.0.0.1 --port 8100 \
    --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 \
    --no-access-log

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

; Hardening. The app writes to exactly one directory and reads its own code.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/srv/scholardrop/uploads
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

; Uploaded theses are only ever readable by this service.
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=scholardrop

[Install]
WantedBy=multi-user.target
