# Copy to .env (development) or /etc/scholardrop.env (production, mode 0640
# root:scholardrop). Everything is optional in dev except SECRET_KEY in
# production. Never commit a real .env.

SCHOLARDROP_ENV=dev

# Signs the session cookie. Required when ENV=production — the app refuses to
# start without it. Rotating it signs everyone out; that is its only effect.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHOLARDROP_SECRET_KEY=

# Cookie flags. Only set SECURE=false when serving over plain HTTP locally;
# in production the cookie must never leave over an unencrypted hop.
SCHOLARDROP_SESSION_COOKIE_NAME=scholardrop_session
SCHOLARDROP_SESSION_COOKIE_SECURE=true
# Idle timeout. 30 min matches the DSpace JWT lifetime — a longer session would
# only carry a dead token.
SCHOLARDROP_SESSION_TTL_SECONDS=1800
SCHOLARDROP_SESSION_SWEEP_INTERVAL_SECONDS=300

# Uploads. The directory must be writable by the service user and is listed in
# the systemd unit's ReadWritePaths. Keep the size cap <= nginx's
# client_max_body_size, or nginx rejects the file before the app can explain.
SCHOLARDROP_UPLOAD_DIR=/srv/scholardrop/uploads
SCHOLARDROP_UPLOAD_MAX_BYTES=104857600
# How long an untouched upload directory survives the sweep.
SCHOLARDROP_UPLOAD_TTL_SECONDS=7200

# Tier 1 metadata extraction. Without a key, extraction falls back to heuristics
# and the flow still works — it just suggests less. Rotating the key needs a
# restart (see the runbook in README.md).
SCHOLARDROP_ANTHROPIC_API_KEY=
SCHOLARDROP_ANTHROPIC_MODEL=claude-opus-5
SCHOLARDROP_ANTHROPIC_EFFORT=low

# Login throttling, per repository and client IP.
SCHOLARDROP_LOGIN_RATE_LIMIT_ATTEMPTS=5
SCHOLARDROP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

SCHOLARDROP_LOG_LEVEL=INFO
