# Copy to .env (development) or /etc/scholardrop.env (production, mode 0640
# root:scholardrop). Everything is optional in dev except SECRET_KEY in
# production. Never commit a real .env.

SCHOLARDROP_ENV=dev

# Signs the session cookie. Required when ENV=production — the app refuses to
# start without it. Rotating it signs everyone out; that is its only effect.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHOLARDROP_SECRET_KEY=

# Cookie flags. Only set SECURE=false when serving over plain HTTP locally;
# in production the cookie must never leave over an unencrypted hop.
SCHOLARDROP_SESSION_COOKIE_NAME=scholardrop_session
SCHOLARDROP_SESSION_COOKIE_SECURE=true
# Idle timeout. 30 min matches the DSpace JWT lifetime — a longer session would
# only carry a dead token.
SCHOLARDROP_SESSION_TTL_SECONDS=1800
SCHOLARDROP_SESSION_SWEEP_INTERVAL_SECONDS=300

# Uploads. The directory must be writable by the service user and is listed in
# the systemd unit's ReadWritePaths. Keep the size cap <= nginx's
# client_max_body_size, or nginx rejects the file before the app can explain.
SCHOLARDROP_UPLOAD_DIR=/srv/scholardrop/uploads
SCHOLARDROP_UPLOAD_MAX_BYTES=104857600
# How long an untouched upload directory survives the sweep.
SCHOLARDROP_UPLOAD_TTL_SECONDS=7200

# Tier 1 metadata extraction. Without a key, extraction falls back to heuristics
# and the flow still works — it just suggests less. Rotating the key needs a
# restart (see the runbook in README.md).
SCHOLARDROP_ANTHROPIC_API_KEY=
SCHOLARDROP_ANTHROPIC_MODEL=claude-opus-5
SCHOLARDROP_ANTHROPIC_EFFORT=low

# Tier 1, local backend: a small open-weight model on this box for embargoed
# documents (docs/local-llm.md). These defaults are Ollama on loopback; blank the
# model to disable the local backend, and a submission marked "restricted content"
# then falls back to heuristics rather than to the cloud.
SCHOLARDROP_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
SCHOLARDROP_LOCAL_LLM_MODEL=qwen3:4b-instruct
# ollama (schema in `format`) | openai (response_format.json_schema, for vLLM,
# llama.cpp server, LM Studio)
SCHOLARDROP_LOCAL_LLM_DIALECT=ollama
# A Q4 4B model on CPU takes 30-90s per ETD, and the first call also loads weights.
SCHOLARDROP_LOCAL_LLM_TIMEOUT_SECONDS=300
# Ollama's 4k default truncates the prompt's tail, which is where the committee
# page is. Must comfortably hold MAX_CHARS (~4 chars/token) plus the answer.
SCHOLARDROP_LOCAL_LLM_NUM_CTX=8192
SCHOLARDROP_LOCAL_LLM_MAX_CHARS=12000

# Login throttling, per repository and client IP. The IP is the connection's, so
# nginx must set X-Forwarded-For and uvicorn must run with --proxy-headers; a
# client's own header is never believed.
SCHOLARDROP_LOGIN_RATE_LIMIT_ATTEMPTS=5
SCHOLARDROP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# How long cached repository configuration (submission forms, vocabularies,
# licences, collection names) stays good. Changing any of it means reconfiguring
# and restarting DSpace, so an hour is generous; lower it while iterating on a
# submission form.
SCHOLARDROP_CONFIG_CACHE_TTL_SECONDS=3600

# Duplicate detection (DESIGN.md §12, docs/dedup.md). Both layers are advisory
# and neither can block a deposit.
SCHOLARDROP_DEDUP_ENABLED=true
# Layer 1, the exact-file check. Needs an index built by
# scripts/harvest_checksums.py; with no file the check is quietly skipped, so a
# fresh deployment behaves as if the feature were off until the first harvest.
SCHOLARDROP_DEDUP_CHECKSUM_ENABLED=true
# A *template*, not the file: the instance key is appended, because one index
# describes one repository. shareok -> var/checksums-shareok.sqlite. An instance
# can override it in instances.yaml.
SCHOLARDROP_DEDUP_CHECKSUM_INDEX_PATH=var/checksums.sqlite
# Layer 2's *fallback* query only. The repository's own duplicates section, when
# it has one, is free and always read.
SCHOLARDROP_DEDUP_TITLE_QUERY_ENABLED=true
# How alike two titles must be to be shown as the same work. High on purpose: a
# panel that is right half the time gets dismissed unread.
SCHOLARDROP_DEDUP_TITLE_THRESHOLD=0.90
SCHOLARDROP_DEDUP_MAX_MATCHES=5

SCHOLARDROP_LOG_LEVEL=INFO
